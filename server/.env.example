# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Local or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/portfolio
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Cloudinary Image Storage
# Sign up at https://cloudinary.com/ and copy credentials from Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# JWT Authentication
# Use a long, unpredictable random string in production (at least 32 characters)
JWT_SECRET=super_secret_jwt_key_replace_this_with_a_secure_random_string_32_chars
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (used by `npm run seed:admin` script)
ADMIN_EMAIL=admin@portfolio.com
ADMIN_PASSWORD=change_this_secure_admin_password_123
